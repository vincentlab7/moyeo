rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* 사용자 본인만 자신의 문서 읽기/수정 */
    match /users/{uid} {
      allow read, update: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null;
    }

    /* 그룹: memberIds 에 포함된 사용자만 접근 */
    match /groups/{groupId} {
      function isMember() {
        return request.auth != null &&
          request.auth.uid in resource.data.memberIds;
      }
      function isOwner() {
        return request.auth != null &&
          request.auth.uid == resource.data.ownerId;
      }
      /* 초대 코드로 참여 시: memberIds 필드에만 자신을 추가하는 update 허용 */
      function isJoiningViaInvite() {
        return request.auth != null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) &&
          request.auth.uid in request.resource.data.memberIds;
      }

      /* 로그인한 사용자라면 그룹 읽기 허용 — 초대 코드 검색에 필요 */
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if isMember() || isJoiningViaInvite();
      allow delete: if isOwner();

      /* 멤버 서브컬렉션 */
      match /members/{memberId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow write: if request.auth != null;
      }

      /* 일정 서브컬렉션 */
      match /schedules/{scheduleId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if request.auth != null &&
          request.auth.uid == resource.data.authorId;
      }

      /* 할일 서브컬렉션 */
      match /todos/{todoId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow update, delete: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      /* 활동 로그 서브컬렉션 */
      match /activities/{activityId} {
        allow read: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        allow create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
        /* readBy·expiresAt·reactions 필드만 업데이트 허용 */
        allow update: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'expiresAt', 'reactions']);
        allow delete: if false;
      }
    }
  }
}
