# Claude AI API 키 (https://console.anthropic.com 에서 발급)
CLAUDE_API_KEY=your_claude_api_key_here

# FCM 서버 키 — Firebase 콘솔 → 프로젝트 설정 → Cloud Messaging → 서버 키(레거시)
FCM_SERVER_KEY=your_fcm_server_key_here

# Google Calendar 연동용 OAuth 2.0 클라이언트 ID
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 JavaScript 원본에 http://localhost:3434 추가 필요
GCAL_CLIENT_ID=your_google_oauth_client_id_here

# 서버 포트 (기본값: 3434)
PORT=3434
